{
  "name": "conpro-ai-website",
  "version": "1.0.0",
  "description": "ConPro.AI - Modern AI-powered website",
  "main": "src/index.js",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\" --names \"BACKEND,FRONTEND\" --prefix-colors \"bgBlue.bold,bgMagenta.bold\"",
    "start:frontend": "ng serve",
    "start:backend": "cd backend && node server.js",
    "start:frontend-only": "ng serve",
    "start:backend-only": "cd backend && node server.js",
    "build": "ng build",
    "build:backend": "echo Backend doesn't need build step",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "keywords": [
    "react",
    "ai",
    "conpro",
    "website"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "emailjs-com": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.3"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
